<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CyborgroidDashboard.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Noto Sans CJK KR, Noto Sans KR, sans-serif" />
        </Style>
    </Application.Styles>
</Application>
