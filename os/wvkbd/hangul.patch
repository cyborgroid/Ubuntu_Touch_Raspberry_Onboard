+/* Keeps the input method in step with the visible layer: Hangul composes only on
+ * the Hangul layer, so the Latin layers type plain letters. */
+static void
+kbd_sync_input_method(struct layout *from, struct layout *to)
+{
+    bool was_hangul = from && strcmp(from->name, "hangul") == 0;
+    bool is_hangul = strcmp(to->name, "hangul") == 0;
+    if (was_hangul != is_hangul)
+        system(is_hangul ? "fcitx5-remote -s hangul >/dev/null 2>&1 &"
+                         : "fcitx5-remote -s keyboard-us >/dev/null 2>&1 &");
+}
+
