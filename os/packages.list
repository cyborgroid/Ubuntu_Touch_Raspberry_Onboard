# Added to the official Ubuntu 26.04 Desktop image for Raspberry Pi, which is otherwise
# left as it is. Installed with --no-install-recommends.

# Korean: the desktop's input method and the on-screen keyboard's Korean layout use these
ibus-hangul
fonts-noto-cjk
fonts-noto-color-emoji

# Home screen tiles the desktop image has no app for
gnome-calls
showtime

# VPN, kill-switch and Wi-Fi radar
wireguard-tools
iptables
iw
