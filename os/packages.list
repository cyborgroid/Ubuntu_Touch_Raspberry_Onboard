# Installed on top of the official Ubuntu 26.04 Desktop image for Raspberry Pi,
# which supplies GNOME, the standard desktop used when a monitor is connected.
# Installed with --no-install-recommends, so anything needed at runtime is listed.

# Ubuntu Touch user interface and apps (Lomiri, from the Ubuntu archive)
lomiri
lomiri-desktop-session
mir-platform-graphics-gbm-kms
lomiri-keyboard
lomiri-polkit-agent
lomiri-indicator-network
lomiri-indicator-transfer
lomiri-indicator-location
lomiri-app-launch-tools
inotify-tools
lomiri-system-settings
lomiri-filemanager-app
lomiri-gallery-app
lomiri-music-app
lomiri-calculator-app
lomiri-clock-app
lomiri-docviewer-app
lomiri-terminal-app
morph-browser

# Network and security
wireguard-tools
iptables
iw
openssh-server

# Calls
baresip-core

# First boot
cloud-guest-utils

# Fonts and Korean input for the desktop
fonts-noto-cjk
fonts-noto-color-emoji
ibus-hangul
